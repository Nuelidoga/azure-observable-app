{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#", "contentVersion": "1.0.0.0",
  "metadata": {"description": "Key Vault (RBAC mode) holding the App Insights connection string; app identity gets Key Vault Secrets User."},
  "parameters": {
    "name": {"type": "string"},
    "principalId": {"type": "string"},
    "secretName": {"type": "string", "defaultValue": "appinsights-connection-string"},
    "secretValue": {"type": "securestring"},
    "tenantId": {"type": "string", "defaultValue": "[subscription().tenantId]"},
    "location": {"type": "string", "defaultValue": "[resourceGroup().location]"},
    "tags": {"type": "object", "defaultValue": {}}
  },
  "variables": {
    "secretsUser": "4633458b-17de-408a-b874-0445c86b69e6"
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "sku": {"family": "A", "name": "standard"},
        "tenantId": "[parameters('tenantId')]",
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[concat(parameters('name'), '/', parameters('secretName'))]",
      "dependsOn": ["[resourceId('Microsoft.KeyVault/vaults', parameters('name'))]"],
      "properties": {"value": "[parameters('secretValue')]"}
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('name')), parameters('principalId'), variables('secretsUser'))]",
      "scope": "[concat('Microsoft.KeyVault/vaults/', parameters('name'))]",
      "dependsOn": ["[resourceId('Microsoft.KeyVault/vaults', parameters('name'))]"],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('secretsUser'))]",
        "principalId": "[parameters('principalId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "secretUri": {"type": "string", "value": "[reference(resourceId('Microsoft.KeyVault/vaults/secrets', parameters('name'), parameters('secretName')), '2023-07-01').secretUri]"}
  }
}
