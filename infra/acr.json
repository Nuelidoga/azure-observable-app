{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#", "contentVersion": "1.0.0.0",
  "metadata": {"description": "Azure Container Registry (Basic) - the app identity gets AcrPull; admin user disabled."},
  "parameters": {
    "name": {"type": "string"},
    "principalId": {"type": "string"},
    "location": {"type": "string", "defaultValue": "[resourceGroup().location]"},
    "tags": {"type": "object", "defaultValue": {}}
  },
  "variables": {
    "acrPull": "7f951dda-4ed3-4680-a7ca-43fe172d538d"
  },
  "resources": [
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {"name": "Basic"},
      "properties": {"adminUserEnabled": false}
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', parameters('name')), parameters('principalId'), variables('acrPull'))]",
      "scope": "[concat('Microsoft.ContainerRegistry/registries/', parameters('name'))]",
      "dependsOn": ["[resourceId('Microsoft.ContainerRegistry/registries', parameters('name'))]"],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPull'))]",
        "principalId": "[parameters('principalId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "loginServer": {"type": "string", "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('name')), '2023-07-01').loginServer]"}
  }
}
