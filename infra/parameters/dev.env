# Environment settings for DEV (ephemeral: created and destroyed by the pipeline).
# Override anything locally in dev.local.env (git-ignored) or via environment variables.
PROJECT="obsapp"                      # keep <= 8 chars, lowercase letters/digits
LOCATION="westeurope"                 # pick a region near you with Container Apps + SQL free offer
OWNER="${OWNER:-me}"
TTL="1d"
ALERT_EMAIL="${ALERT_EMAIL:-CHANGE_ME}"
SQL_ADMIN_LOGIN="${SQL_ADMIN_LOGIN:-CHANGE_ME}"          # your UPN, or the pipeline service principal name
SQL_ADMIN_OBJECT_ID="${SQL_ADMIN_OBJECT_ID:-CHANGE_ME}"  # object id of that user / service principal
SQL_ADMIN_TYPE="${SQL_ADMIN_TYPE:-User}"                 # User | Application | Group
USE_SQL_FREE_OFFER="true"
LOG_DAILY_CAP_GB="0.5"
MIN_REPLICAS="0"                      # 0 = scale to zero (cheapest)
ENABLE_CHAOS="true"                   # enables /chaos/* endpoints for the alert demo
