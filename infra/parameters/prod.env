# Environment settings for PROD-LIKE (deployed only for demo windows, behind a manual approval).
PROJECT="obsapp"
LOCATION="westeurope"
OWNER="${OWNER:-me}"
TTL="demo"
ALERT_EMAIL="${ALERT_EMAIL:-CHANGE_ME}"
SQL_ADMIN_LOGIN="${SQL_ADMIN_LOGIN:-CHANGE_ME}"
SQL_ADMIN_OBJECT_ID="${SQL_ADMIN_OBJECT_ID:-CHANGE_ME}"
SQL_ADMIN_TYPE="${SQL_ADMIN_TYPE:-User}"
USE_SQL_FREE_OFFER="true"
LOG_DAILY_CAP_GB="1"
MIN_REPLICAS="1"                      # one warm replica so alerts and restarts are observable
ENABLE_CHAOS="false"
